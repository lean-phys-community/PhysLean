      · rw [Fin.prod_univ_two, h30, lightConeCoeffInv_three_eq_zero
          (μ := d 0) 1 (by simpa using hd), zero_mul, zero_smul]
        exact Submodule.zero_mem _
      · rw [Fin.prod_univ_two, h12, lightConeCoeffInv_two_eq_zero
