    · refine le_sup_of_le_right ?_
      rw [Submodule.span_singleton_le_iff_mem]
      refine Submodule.mem_iSup_of_mem ![] ?_
      rw [h.range_quarticSymbol]
      exact Submodule.mem_span_singleton_self _
    · exact bot_le

